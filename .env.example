PORT=8080
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL_SECONDS=3600
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OTP_TTL_SECONDS=300
OTP_MIN_INTERVAL_SECONDS=30
HEALTH_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Prefer DATABASE_URL (postgres://… from Fly/Supabase) — auto-mapped to JDBC.
# Or set SPRING_DATASOURCE_* explicitly.
# DATABASE_URL=postgres://user:pass@host:5432/postgres
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/postgres
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
